<Window x:Class="CatVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CatVideo"
        Title="Cat螢幕轉換器" Width="560" Height="700" MinWidth="360" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" UseLayoutRounding="True"
        Background="#FFF8EC" Foreground="#5B2B19" FontFamily="Microsoft JhengHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Cream" Color="#FFF8EC"/>
        <SolidColorBrush x:Key="Brown" Color="#5B2B19"/>
        <SolidColorBrush x:Key="Gold" Color="#EDAA4D"/>
        <SolidColorBrush x:Key="Peach" Color="#FFC5A9"/>
        <SolidColorBrush x:Key="Pink" Color="#EC908B"/>
        <SolidColorBrush x:Key="Sand" Color="#EDD8B7"/>
        <SolidColorBrush x:Key="Orange" Color="#E07F3E"/>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Background" Value="#FAECD5"/>
            <Setter Property="Foreground" Value="{StaticResource Brown}"/>
            <Setter Property="BorderBrush" Value="#DDA658"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Canvas x:Name="Ears" Visibility="Collapsed" IsHitTestVisible="False">
                                <Path Data="M 33,30 L 47,3 Q 50,-1 54,5 L 77,30 Z" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                                <Path Data="M 42,28 L 49,12 L 65,28 Z" Fill="{StaticResource Pink}"/>
                                <Path Data="M 266,30 L 288,5 Q 293,-1 296,4 L 310,30 Z" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                                <Path Data="M 276,28 L 292,12 L 301,28 Z" Fill="{StaticResource Pink}"/>
                            </Canvas>
                            <Border x:Name="Card" Margin="3,22,3,3" CornerRadius="23" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
                                <Grid>
                                    <Canvas x:Name="Prints" IsHitTestVisible="False" Opacity="0.42">
                                        <local:CatArt Kind="Paw" Width="24" Height="28" Canvas.Left="18" Canvas.Top="31" Fill="#C3792A"/>
                                        <local:CatArt Kind="Paw" Width="24" Height="28" Canvas.Left="39" Canvas.Top="91" Fill="#C3792A"/>
                                        <local:CatArt Kind="Paw" Width="24" Height="28" Canvas.Left="284" Canvas.Top="18" Fill="#C3792A"/>
                                        <local:CatArt Kind="Paw" Width="24" Height="28" Canvas.Left="296" Canvas.Top="87" Fill="#C3792A"/>
                                    </Canvas>
                                    <StackPanel VerticalAlignment="Center" Margin="18,4,18,0">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="28" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding ToolTip}" FontSize="16" Margin="0,17,0,0" Foreground="{TemplateBinding Foreground}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="Focus" Margin="9,28,9,9" BorderBrush="{StaticResource Brown}" BorderThickness="1" CornerRadius="18" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Cat">
                                <Setter TargetName="Ears" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Prints" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Gold}"/>
                                <Setter Property="Foreground" Value="#FFFCED"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Orange}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CatSlider" TargetType="Slider">
            <Setter Property="Height" Value="48"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Background="{StaticResource Sand}" Height="8" CornerRadius="4" Margin="20,0" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="8" CornerRadius="4" Margin="20,0,0,0" VerticalAlignment="Center">
                                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EC908B" Offset="0"/><GradientStop Color="#EDAA4D" Offset="1"/></LinearGradientBrush></Border.Background>
                                                    </Border>
                                                    <local:TrailArt Height="32" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource TrackButton}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="40" Height="44" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <local:CatArt x:Name="Paw" Kind="Badge" Width="36" Height="38"/>
                                                    <local:CatArt x:Name="Cat" Kind="Head" Width="36" Height="38" Visibility="Collapsed" Fill="{StaticResource Pink}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="Cat">
                                                        <Setter TargetName="Paw" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="Cat" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <Border x:Name="Focus" BorderBrush="{StaticResource Brown}" BorderThickness="1" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Orange}"/>
            <Setter Property="Foreground" Value="#FFF9EA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="27" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brown}" BorderThickness="1.5">
                                <Grid Margin="15,0,10,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <local:CatArt Grid.Column="1" Kind="Badge" Width="31" Height="34"/>
                                </Grid>
                            </Border>
                            <Border x:Name="Focus" CornerRadius="20" Margin="5" BorderBrush="{StaticResource Brown}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EE924A"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource Cream}">
        <!-- WPF scales the visuals and input hit areas together. The finite
             canvas lets Uniform keep all of the content inside the window. -->
        <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="760" Height="960" Background="{StaticResource Cream}" ClipToBounds="True">
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="提升貓的工作效率" FontSize="34" FontWeight="Bold"/>
                <TextBlock Canvas.Left="28" Canvas.Top="82" Text="提供貓專用的色差顯示，讓值班畫面更好分辨。" FontSize="16"/>
                <local:CatArt Kind="Stretch" Canvas.Left="601" Canvas.Top="17" Width="125" Height="80"/>
                <RadioButton x:Name="NormalMode" Canvas.Left="28" Canvas.Top="120" Width="344" Height="158" Content="正常" ToolTip="人類值班用的標準色彩" GroupName="DisplayMode" Style="{StaticResource ModeCard}" Click="Normal_Click" IsChecked="True" AutomationProperties.Name="正常模式"/>
                <RadioButton x:Name="CatMode" Canvas.Left="388" Canvas.Top="120" Width="344" Height="158" Content="貓" ToolTip="貓咪值班用的專屬色彩" Tag="Cat" GroupName="DisplayMode" Style="{StaticResource ModeCard}" Click="Cat_Click" AutomationProperties.Name="貓模式"/>
                <Grid Canvas.Left="28" Canvas.Top="290" Width="704" Height="56">
                    <Path Data="M 11,22 L 17,3 L 40,22 Z" Fill="{StaticResource Peach}" Stroke="#CE846D" StrokeThickness="2"/>
                    <Border Height="44" VerticalAlignment="Bottom" CornerRadius="22" Background="{StaticResource Peach}" BorderBrush="#CE846D" BorderThickness="2"/>
                    <TextBlock x:Name="StatusText" Margin="18,18,50,0" FontSize="16" Text="人類值班中，畫面維持正常色彩。"/>
                    <local:CatArt Kind="Paw" Fill="#A7583F" Width="25" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8"/>
                </Grid>
                <TextBlock Canvas.Left="28" Canvas.Top="368" Text="貓用色差強度" FontSize="16"/>
                <TextBlock x:Name="StrengthValue" Canvas.Left="650" Canvas.Top="368" Width="82" Text="75%" FontSize="16" TextAlignment="Right"/>
                <Slider x:Name="StrengthSlider" Canvas.Left="28" Canvas.Top="396" Width="704" Minimum="0" Maximum="100" Value="75" Style="{StaticResource CatSlider}" ValueChanged="SettingsChanged" AutomationProperties.Name="貓用色差強度"/>
                <TextBlock Canvas.Left="28" Canvas.Top="469" Text="工作畫面亮度" FontSize="16"/>
                <TextBlock x:Name="BrightnessValue" Canvas.Left="650" Canvas.Top="469" Width="82" Text="100%" FontSize="16" TextAlignment="Right"/>
                <Slider x:Name="BrightnessSlider" Canvas.Left="28" Canvas.Top="497" Width="704" Minimum="80" Maximum="120" Value="100" Style="{StaticResource CatSlider}" ValueChanged="SettingsChanged" AutomationProperties.Name="工作畫面亮度"/>
                <TextBlock Canvas.Left="28" Canvas.Top="570" Text="畫面明暗對比" FontSize="16"/>
                <TextBlock x:Name="ContrastValue" Canvas.Left="650" Canvas.Top="570" Width="82" Text="100%" FontSize="16" TextAlignment="Right"/>
                <Slider x:Name="ContrastSlider" Canvas.Left="28" Canvas.Top="598" Width="704" Minimum="80" Maximum="120" Value="100" Tag="Cat" Style="{StaticResource CatSlider}" ValueChanged="SettingsChanged" AutomationProperties.Name="畫面明暗對比"/>
                <Button Canvas.Left="28" Canvas.Top="676" Width="260" Height="54" Content="回到預設工作設定" FontSize="16" Style="{StaticResource ResetButton}" Click="Defaults_Click" AutomationProperties.Name="回到預設工作設定"/>
                <TextBlock x:Name="ShortcutText" Canvas.Left="28" Canvas.Top="750" Text="交回人類值班：Ctrl + Alt + N" FontSize="15"/>
                <TextBlock Canvas.Left="28" Canvas.Top="804" FontSize="13.5" LineHeight="22" Text="使用近似色差轉換，協助貓咪分辨螢幕畫面。&#10;調整在貓模式生效；下班關閉後，畫面就會恢復原本色彩。"/>
                <local:CatArt Kind="Paw" Fill="{StaticResource Brown}" Canvas.Left="691" Canvas.Top="792" Width="22" Height="25"/>
                <local:CatArt Kind="Footer" Canvas.Left="504" Canvas.Top="832" Width="228" Height="114"/>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
